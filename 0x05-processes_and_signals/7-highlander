#!/usr/bin/env bash
# Infinite loop that handles SIGTERM by printing a message instead of terminating

# Function to handle SIGTERM
handle_sigterm() {
    echo "I am invincible!!!"
}

# Trap SIGTERM and call handle_sigterm
trap 'handle_sigterm' SIGTERM

# Infinite loop
while true; do
    echo "To infinity and beyond"
    sleep 2
done
